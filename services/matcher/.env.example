# Copy to .env. Never commit the real file — it holds a key that can move a provider's stake.

# Chain
RPC_URL=https://testnet-rpc.monad.xyz
# Order notifications. Defaults to RPC_URL over a socket; polling is the fallback.
WS_URL=wss://testnet-rpc.monad.xyz
RAIL_CORE=0xfa8C88Ee0fCF869783F489cADB222750F576f221
LP_REGISTRY=0x4C10f838b44A67C09B368c744D0d281cB3407E09

# This provider's key. It stakes collateral and bids; it never touches a sender's money.
LP_PRIVATE_KEY=

# What this provider will deliver, and at what margin.
CURRENCIES=NGN
# Your own cost of naira per dollar. Keep it current: a stale rate bids below cost or above the ceiling.
RATE=1331
# Your margin. It must sit inside the sender's 2% reserve buffer or every bid is priced out.
SPREAD_BPS=100
# Keep under your free stake / 1.1, or a winning reveal cannot lock its collateral.
MAX_ORDER_AUSD=180000000

# Only bid when the sender's chosen attestor is one you accept. Empty means any.
ATTESTOR_ALLOWLIST=

# Only used if the WebSocket will not open. The commit window is about 45 seconds.
POLL_INTERVAL_MS=1000
STATE_DIR=.matcher
MATCHER_LABEL=

# Testnet convenience: mark the payout made without a human confirming the naira really left.
# Never set this on mainnet — it tells the chain you paid when you may not have.
AUTO_CONFIRM_PAYOUT=false
