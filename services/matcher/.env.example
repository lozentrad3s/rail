# Copy to .env. Never commit the real file — it holds a key that can move a provider's stake.

# Chain
RPC_URL=https://testnet-rpc.monad.xyz
# Order notifications. Defaults to RPC_URL over a socket; polling is the fallback.
WS_URL=wss://testnet-rpc.monad.xyz
RAIL_CORE=0xf0A34887d703300FA73533678A4a1f9D3B68c27F
LP_REGISTRY=0xbcbB919329A3f86ddC6A3c948788201c2fD48b5a

# This provider's key. It stakes collateral and bids; it never touches a sender's money.
LP_PRIVATE_KEY=

# What this provider will deliver, and at what margin.
CURRENCIES=NGN
RATE=1534
SPREAD_BPS=150
MAX_ORDER_AUSD=500000000

# Only bid when the sender's chosen attestor is one you accept. Empty means any.
ATTESTOR_ALLOWLIST=

# The commit window is about a second and a half, so keep this well under a second.
POLL_INTERVAL_MS=250
STATE_DIR=.matcher
MATCHER_LABEL=

# Testnet convenience: mark the payout made without a human confirming the naira really left.
# Never set this on mainnet — it tells the chain you paid when you may not have.
AUTO_CONFIRM_PAYOUT=false
