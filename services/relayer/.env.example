# Copy to .env. Never commit the real file.

PORT=8787
RPC_URL=https://testnet-rpc.monad.xyz

# The pilot deployment (docs/DEPLOYMENTS.md).
RAIL_CORE=0x90026A694D392888dd8feEbC63ccA729A037a2D0
RAIL_ATTESTOR=0x0ECc0916113D70875B7BEE2F27AF64cCfe57a90e
AUSD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC

# Pays gas and nothing else. It cannot move a sender's money.
RELAYER_PRIVATE_KEY=

# Encrypts recipient bank details at rest. 32 bytes of hex; rotating it orphans stored details.
RECIPIENT_ENCRYPTION_KEY=

# Pricing until there are settled orders to price from.
FALLBACK_RATE=1534
RESERVE_BUFFER_BPS=200
FEE_AUSD=130000
QUOTE_TTL_SECONDS=120

# Shared secret the WhatsApp bot presents on its own endpoints.
BOT_API_KEY=
