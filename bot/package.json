{
  "name": "rail-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp bot: proposes payments and hands back links. It never holds a key and never moves money",
  "scripts": {
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/index.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "journey": "node scripts/journey.ts"
  },
  "dependencies": {
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
