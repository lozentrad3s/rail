# All optional — see README.md. Never put secrets in NEXT_PUBLIC_ variables; they ship to the browser.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PILOT_URL=
NEXT_PUBLIC_REPO_URL=

# Passkey relying party: the production domain, and nothing else. A passkey binds permanently to the
# host that created it, so a preview deployment must never mint an account. localhost is allowed for
# development. See docs/INTERFACES.md §5.5.1.
NEXT_PUBLIC_PASSKEY_RP_ID=

# Read-only chain endpoint for showing a balance. Defaults to the public Monad testnet RPC.
NEXT_PUBLIC_RPC_URL=

# Dynamic environment ID for the provider dashboard login (public: it ships in the browser bundle).
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Where the relayer answers. The app never sends a key here — only what a passkey already signed.
NEXT_PUBLIC_RELAYER_URL=http://localhost:8787

# The escrow and the settlement asset the app reads and signs against.
NEXT_PUBLIC_RAIL_CORE=0x90026A694D392888dd8feEbC63ccA729A037a2D0
NEXT_PUBLIC_SETTLEMENT_ASSET=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC

# The live chat. Telegram needs no business verification, so it is the pilot transport.
NEXT_PUBLIC_TELEGRAM_BOT=RailpayBot

# Envio GraphQL endpoint. The dashboard reads a sender's history from it, so the same account shows
# the same transfers on every device. On the development tier the URL changes per deployment:
# envio-cloud deployment endpoint rail <commit> lozentrad3s
NEXT_PUBLIC_INDEXER_URL=
